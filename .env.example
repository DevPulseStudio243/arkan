# ============================================================
#  ARKAN EPC COPILOT — .env.example
#  Template de configuration d'environnement (valeurs anonymisées)
#  Copiez ce fichier vers .env et renseignez vos informations locales.
# ============================================================

# ── Neo4j Graph Database ─────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j
NEO4J_ENABLED=true
NEO4J_TIMEOUT=5

# ── Ollama LLM & Embeddings ──────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=arkan-planning
ARKAN_LLM_MODEL=arkan-planning
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_VISION_MODEL=qwen2.5vl:3b
LLM_TIMEOUT=600
ARKAN_LLM_TEMP=0.1
ARKAN_LLM_MAX_TOKENS=2048
LLM_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=5m

# ── ChromaDB Vector Store ────────────────────────────────────
CHROMA_MODE=local
CHROMA_HOST=localhost
CHROMA_PORT=8001
ARKAN_CHROMA_PATH=chroma_db

# ── API Server & Cloud LLM ──────────────────────────────────
API_PORT=8000
API_KEY=your_secure_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ── Embeddings Configuration ─────────────────────────────────
ARKAN_EMBEDDING_MODEL=nomic-embed-text
ARKAN_EMBEDDING_DIM=768

# ── Base Directories & Storage ───────────────────────────────
ARKAN_BASE_DIR=.
RAG_DATA_PATH=data/rag
KNOWLEDGE_GRAPH_PATH=data/kg
FEEDBACK_DB_PATH=data/feedback

# ── Retrieval & Hybrid RAG ───────────────────────────────────
ARKAN_TOP_K=10
ARKAN_VECTOR_WEIGHT=0.6
ARKAN_BM25_WEIGHT=0.4
ARKAN_HALLUCINATION_THRESHOLD=0.4
ARKAN_RERANK_ENABLED=true

# ── Logging & Telemetry ──────────────────────────────────────
ARKAN_LOG_LEVEL=INFO
ARKAN_LOG_FILE=logs/arkan.log
ARKAN_AUTO_INDEX=true
ARKAN_AUTO_LEARN=true
ANONYMIZED_TELEMETRY=false
CHROMA_TELEMETRY=false

# ── Advanced Modules ─────────────────────────────────────────
LIGHTRAG_ENABLED=false
DOCLING_ENABLED=true
ARKAN_MAX_CPU_RATIO=0.8
ARKAN_MAX_RAM_RATIO=0.8
